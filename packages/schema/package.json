{
  "name": "@directededges/specs-schema",
  "version": "0.40.0",
  "description": "Specs UI Component Schema - TypeScript types and JSON schema definitions for component specifications",
  "license": "CC-BY-4.0",
  "author": "Nathan Curtis <nathan@directededges.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/DirectedEdges/spectacular.git",
    "directory": "packages/schema"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./types/index.ts",
  "exports": {
    ".": {
      "types": "./types/index.ts",
      "default": "./dist/index.js"
    },
    "./schema/component": "./schema/component.schema.json",
    "./schema/component-concern": "./schema/component-concern.schema.json",
    "./schema/metadata": "./schema/metadata.schema.json",
    "./schema/styles": "./schema/styles.schema.json",
    "./schema/root": "./schema/root.schema.json",
    "./schema/conventions": "./schema/conventions.schema.json",
    "./schema/settings": "./schema/settings.schema.json",
    "./schema/supplemental": "./schema/supplemental.schema.json",
    "./schema/guidelines": "./schema/guidelines.schema.json"
  },
  "files": [
    "dist",
    "types",
    "schema",
    "mappings",
    "!mappings/_style-page-content.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "specs",
    "component",
    "schema",
    "figma",
    "design-system",
    "specifications",
    "types",
    "typescript"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
