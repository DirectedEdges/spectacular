{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spectacular.systems/schema/0.39.0/components.schema.json",
  "title": "Specs Components Set Schema",
  "description": "A set of named components, each conforming to the Specs component schema.",
  "type": "object",
  "properties": {
    "components": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": { "$ref": "component.schema.json" }
      },
      "additionalProperties": false
    }
  },
  "required": ["components"],
  "additionalProperties": false
}
