    "styleClusters": {
      "autoVsAbsoluteLayout": {
        "disposition": "bound",
        "keys": [
          "position",
          "top",
          "bottom",
          "start",
          "end",
          "centerHorizontalOffset",
          "centerVerticalOffset",
          "layoutSizingHorizontal",
          "layoutSizingVertical",
          "width",
          "height"
        ],
        "outputs": [
          "node.layoutPositioning",
          "node.x",
          "node.y",
          "node.constraints",
          "node.layoutSizingHorizontal",
          "node.layoutSizingVertical"
        ],
        "resolution": "On the READ side these keys are not read from single Figma properties at all. relateAutoVsAbsoluteLayout computes position, the four insets and the two centre offsets from node.constraints plus geometry and parent dimensions (ADR-041). width and height are nulled when the matching layoutSizing is HUG or FILL; layoutSizing is nulled for an absolutely positioned child.",
        "partial": "A STRETCH constraint emits both edges and suppresses the dimension. SCALE emits both edges as percentage strings.",
        "stage": "postEvaluate",
        "notes": "specs-from-figma StylesProcessor.ts:108-274. These keys are POST-PROCESSED, not read — a binding presenting them as direct reads misleads anyone implementing a second time."
      },
      "wrapping": {
        "disposition": "bound",
        "keys": [
          "wrap",
          "wrapAlignment",
          "itemSpacing",
          "layoutMode"
        ],
        "outputs": [
          "node.layoutWrap",
          "node.counterAxisAlignContent",
          "node.itemSpacing",
          "node.counterAxisSpacing"
        ],
        "resolution": "wrapAlignment is REMOVED entirely when layoutWrap is not WRAP — a dead property otherwise. itemSpacing becomes a biaxial composite only when layoutMode is HORIZONTAL or VERTICAL and wrap is active, mapping Figma primary/counter axis onto absolute horizontal/vertical.",
        "partial": "With no auto-layout, wrap is forced false and mainAxisAlignment, crossAxisAlignment and wrapAlignment are forced null.",
        "stage": "postEvaluate",
        "notes": "specs-from-figma StylesProcessor.ts:291-300; Style.ts:489-564; BiaxialComposite.ts:29-45"
      },
      "namedStyleVersusInline": {
        "disposition": "bound",
        "keys": [
          "typography"
        ],
        "outputs": [
          "node.textStyleId",
          "~13 inline text properties"
        ],
        "resolution": "A named Figma text style produces a style reference and REMOVES typography. With no named style, typography is re-injected from the unvaried baseline when the variant diff dropped it.",
        "partial": "Typography sub-fields are separately compared against their own TYPOGRAPHY_DEFAULTS constant, a second and distinct default source.",
        "stage": "postProcess",
        "notes": "specs-from-figma StylesProcessor.ts relateTextStyleAndTextProperties; TypographyProcessor.ts:74-80"
      }
    }
  },
  "valueForms": {
    "summary": "Every style value may be a literal, a TokenReference, a PropBinding, or a Conditional. A binding must say what it does with each.",
    "literal": "bound",
    "tokenReference": "bound — resolves the Figma variable; falls back to $extensions[com.figma].rawValue where the variable is unavailable",
    "propBinding": "unverified",
    "conditional": "unverified"
  }
