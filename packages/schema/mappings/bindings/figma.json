    "styleClusters": {
      "autoVsAbsoluteLayout": {
        "disposition": "bound",
        "keys": [
          "position",
          "top",
          "bottom",
          "start",
          "end",
          "centerHorizontalOffset",
          "centerVerticalOffset",
          "layoutSizingHorizontal",
          "layoutSizingVertical",
          "width",
          "height"
        ],
        "outputs": [
          "node.layoutPositioning",
          "node.x",
          "node.y",
          "node.constraints",
          "node.layoutSizingHorizontal",
          "node.layoutSizingVertical"
        ],
        "stage": "postEvaluate",
        "notes": "Per axis. These keys are computed from constraints and geometry, never read from a single Figma property — a binding presenting them as direct reads misleads anyone implementing a second time. ADR-041 governs the constraint mapping.",
        "direction": "figma-to-spec",
        "form": "cases",
        "inputs": [
          {
            "ref": "node.constraints.horizontal",
            "from": "Figma node"
          },
          {
            "ref": "node.constraints.vertical",
            "from": "Figma node"
          },
          {
            "ref": "node.position",
            "from": "Figma node geometry"
          },
          {
            "ref": "node.dimension",
            "from": "Figma node geometry"
          },
          {
            "ref": "parent.dimension",
            "from": "Figma parent geometry"
          },
          {
            "ref": "parent.layoutMode",
            "from": "Figma parent"
          },
          {
            "ref": "self.layoutSizing",
            "from": "the axis-matching sizing key"
          },
          {
            "ref": "context.isRoot",
            "from": "capture context"
          }
        ],
        "cases": [
          {
            "when": {
              "operation": "equals",
              "args": {
                "value": "node.constraints",
                "compareTo": "MIN"
              }
            },
            "emit": [
              "the leading edge offset — `start` or `top` — set to the node position"
            ]
          },
          {
            "when": {
              "operation": "equals",
              "args": {
                "value": "node.constraints",
                "compareTo": "MAX"
              }
            },
            "emit": [
              "the trailing edge offset — `end` or `bottom` — set to parent dimension less node position less node dimension"
            ]
          },
          {
            "when": {
              "operation": "equals",
              "args": {
                "value": "node.constraints",
                "compareTo": "CENTER"
              }
            },
            "emit": [
              "the matching centre offset, set to node position plus half the node dimension less half the parent dimension"
            ]
          },
          {
            "when": {
              "operation": "equals",
              "args": {
                "value": "node.constraints",
                "compareTo": "STRETCH"
              }
            },
            "emit": [
              "both edge offsets on the axis",
              "the axis dimension suppressed"
            ],
            "why": "a stretched node is defined by its edges, not its size"
          },
          {
            "when": {
              "operation": "equals",
              "args": {
                "value": "node.constraints",
                "compareTo": "SCALE"
              }
            },
            "emit": [
              "both edge offsets on the axis, as percentage strings"
            ]
          }
        ],
        "relationCases": [
          {
            "when": {
              "operation": "any",
              "args": [
                {
                  "operation": "equals",
                  "args": {
                    "value": "self.layoutSizing",
                    "compareTo": "HUG"
                  }
                },
                {
                  "operation": "equals",
                  "args": {
                    "value": "self.layoutSizing",
                    "compareTo": "FILL"
                  }
                }
              ]
            },
            "emit": [
              "the matching `width` or `height` nulled"
            ],
            "why": "a hugged or filled axis has no fixed dimension to record"
          },
          {
            "when": {
              "operation": "equals",
              "args": {
                "value": "self.layoutSizing",
                "compareTo": "FIXED"
              }
            },
            "emit": [
              "the matching `width` or `height` present"
            ]
          },
          {
            "when": {
              "operation": "equals",
              "args": {
                "value": "self.position",
                "compareTo": "ABSOLUTE"
              }
            },
            "emit": [
              "`layoutSizingHorizontal` and `layoutSizingVertical` nulled"
            ],
            "why": "an absolutely positioned child is not sized by the parent axis"
          }
        ],
        "otherwise": {
          "emit": [],
          "why": "a flow-placed child in auto-layout records no positioning offsets"
        },
        "basis": "intent"
      },
      "wrapping": {
        "disposition": "bound",
        "keys": [
          "wrap",
          "wrapAlignment",
          "itemSpacing",
          "layoutMode"
        ],
        "outputs": [
          "node.layoutWrap",
          "node.counterAxisAlignContent",
          "node.itemSpacing",
          "node.counterAxisSpacing"
        ],
        "stage": "postEvaluate",
        "notes": "A property that cannot apply is removed rather than recorded as null, so a reader never sees a dead key.",
        "direction": "figma-to-spec",
        "form": "cases",
        "inputs": [
          {
            "ref": "node.layoutMode",
            "from": "Figma node"
          },
          {
            "ref": "node.layoutWrap",
            "from": "Figma node"
          },
          {
            "ref": "node.itemSpacing",
            "from": "Figma node"
          },
          {
            "ref": "node.counterAxisSpacing",
            "from": "Figma node"
          }
        ],
        "cases": [
          {
            "when": {
              "operation": "any",
              "args": [
                {
                  "operation": "isNull",
                  "args": {
                    "value": "node.layoutMode"
                  }
                },
                {
                  "operation": "equals",
                  "args": {
                    "value": "node.layoutMode",
                    "compareTo": "NONE"
                  }
                }
              ]
            },
            "emit": [
              "`wrap` false",
              "`mainAxisAlignment` null",
              "`crossAxisAlignment` null",
              "`wrapAlignment` null"
            ],
            "why": "none of them mean anything without auto-layout"
          },
          {
            "when": {
              "operation": "notEquals",
              "args": {
                "value": "node.layoutWrap",
                "compareTo": "WRAP"
              }
            },
            "emit": [
              "`wrapAlignment` removed entirely"
            ],
            "why": "a dead property otherwise — removed, not nulled"
          },
          {
            "when": {
              "operation": "all",
              "args": [
                {
                  "operation": "any",
                  "args": [
                    {
                      "operation": "equals",
                      "args": {
                        "value": "node.layoutMode",
                        "compareTo": "HORIZONTAL"
                      }
                    },
                    {
                      "operation": "equals",
                      "args": {
                        "value": "node.layoutMode",
                        "compareTo": "VERTICAL"
                      }
                    }
                  ]
                },
                {
                  "operation": "equals",
                  "args": {
                    "value": "node.layoutWrap",
                    "compareTo": "WRAP"
                  }
                }
              ]
            },
            "emit": [
              "`itemSpacing` as a biaxial composite, mapping the Figma primary and counter axes onto absolute horizontal and vertical"
            ]
          },
          {
            "when": {
              "operation": "isNotNull",
              "args": {
                "value": "node.itemSpacing"
              }
            },
            "emit": [
              "`itemSpacing` as a scalar"
            ]
          }
        ],
        "otherwise": {
          "emit": []
        },
        "basis": "intent"
      },
      "namedStyleVersusInline": {
        "disposition": "bound",
        "keys": [
          "typography"
        ],
        "outputs": [
          "node.textStyleId",
          "~13 inline text properties"
        ],
        "stage": "postProcess",
        "notes": "A named text style and inline typography are mutually exclusive in a document: one is a reference, the other is the resolved values. Typography sub-fields are additionally compared against their own defaults, a second and distinct default source from the style keys.",
        "direction": "figma-to-spec",
        "form": "cases",
        "inputs": [
          {
            "ref": "node.textStyleId",
            "from": "Figma node"
          },
          {
            "ref": "baseline.typography",
            "from": "the unvaried baseline for this element"
          }
        ],
        "cases": [
          {
            "when": {
              "operation": "isNotNull",
              "args": {
                "value": "node.textStyleId"
              }
            },
            "emit": [
              "a style reference",
              "`typography` removed"
            ],
            "why": "the named style is the source; resolved values beside it would be a second copy"
          },
          {
            "when": {
              "operation": "all",
              "args": [
                {
                  "operation": "isNull",
                  "args": {
                    "value": "node.textStyleId"
                  }
                },
                {
                  "operation": "isNull",
                  "args": {
                    "value": "self.typography"
                  }
                },
                {
                  "operation": "isNotNull",
                  "args": {
                    "value": "baseline.typography"
                  }
                }
              ]
            },
            "emit": [
              "`typography` re-injected from the baseline"
            ],
            "why": "a variant diff dropped it, but with no named style the values are the only record"
          },
          {
            "when": {
              "operation": "isNull",
              "args": {
                "value": "node.textStyleId"
              }
            },
            "emit": [
              "`typography` as resolved values"
            ]
          }
        ],
        "otherwise": {
          "emit": []
        },
        "basis": "intent"
      }
    }
  },
  "valueForms": {
    "summary": "Every style value may be a literal, a TokenReference, a PropBinding, or a Conditional. A disposition for a key means little without saying what happens to each form (DSPEC-42).",
    "literal": "bound",
    "literalNote": "The ordinary case.",
    "tokenReference": "bound",
    "tokenReferenceNote": "Recognised by its `$token` key and resolved to a Figma variable. Where the variable cannot be resolved, the value falls back to the cached raw value the document carries, which is a degradation using only data the document holds (DSPEC-43).",
    "propBinding": "bound",
    "propBindingNote": "A dedicated binding path parses `{ $binding: \"#/props/NAME\" }` and wires the corresponding Figma node field to the component property.",
    "propBindingVerified": false,
    "conditional": "bound",
    "conditionalNote": "The ADR-018 conditional form is implemented on the render path: the condition’s binding target is resolved dynamically and the then/else branch applied. This is the one platform that honours it.",
    "conditionalVerified": false
  },
  "directions": {
    "figma-to-spec": "Capture. A Figma file becomes a document.",
    "spec-to-figma": "Render. A document becomes nodes on the canvas."
  },
  "onAbsentVocabulary": {
    "declaredDefault": "Applies the value the schema declares for an absent key.",
    "platformInitial": "Applies the platform's own initial value, which may differ from the schema's declared default.",
    "warns": "Warns and applies nothing.",
    "nothing": "Applies nothing, silently.",
    "unverified": "Nobody has established what this platform does when the key is absent."
  },
  "onAbsentNote": "What this platform does when a style key is absent from a document. The schema declares the meaning of absence once (§4.1a); this records whether the platform honours it. A row whose onAbsent is not declaredDefault is a disagreement with the contract, and each one is a decision rather than an accident.",
  "basisVocabulary": {
    "implementation": "Verified against a citable implementation. The drift guard checks it, and a change to that implementation fails the build.",
    "intent": "Asserted from the authoritative source for what the data means, which is not publicly citable. Nothing mechanical checks it; a reviewer must."
  },
  "basisNote": "Whether a claim is checked or asserted. Figma is bidirectional: a render claim is verified against a citable implementation, while a capture claim rests on the authoritative capture engine, which is private — so nothing mechanical can check it and a reader should know that."
