// Generated by `specs storybook` — rewritten on every publish. To take control
// of this page, copy it to content-overrides/foundations/Images.stories.tsx and
// edit the copy; it then always wins and publish never touches it.
import * as React from 'react';
import type { Meta, StoryObj } from '@storybook/react';
// Via the workspace-anchored path (not './data/…') so a copy of this file in
// content-overrides/foundations/ keeps reading the published data.
import data from '../../content/foundations/data/images.json';


const images = data as {
  present: Array<{
    file: string;
    hash: string;
    name?: string;
    origin: Array<'style' | 'component'>;
    referencedBy: string[];
    bytes: number;
  }>;
  missing: Array<{ hash: string; referencedBy: string[] }>;
};

function kb(bytes: number) {
  return bytes >= 1048576
    ? `${(bytes / 1048576).toFixed(1)} MB`
    : `${Math.max(1, Math.round(bytes / 1024))} KB`;
}

/** Where the image lives in Figma. An empty origin means no producer has recorded it. */
const ORIGIN_LABEL: Record<string, string> = {
  style: 'Fill style',
  component: 'On a component',
};

function originText(origin: Array<'style' | 'component'>) {
  if (origin.length === 0) return 'Unaccounted for';
  return origin.map((o) => ORIGIN_LABEL[o] ?? o).join(' · ');
}

function ImagesPage() {
  const fromStyles = images.present.filter((i) => i.origin.includes('style')).length;
  const unaccounted = images.present.filter((i) => i.origin.length === 0).length;

  return (
    <>
      <h1>Images</h1>

      {images.missing.length > 0 && (
        <div
          style={{
            border: '1px solid crimson',
            borderRadius: 4,
            padding: '12px 16px',
            marginBottom: 24,
          }}
        >
          <p style={{ color: 'crimson', fontWeight: 600, marginTop: 0 }}>
            {images.missing.length} referenced {images.missing.length === 1 ? 'image has' : 'images have'} no file
          </p>
          <p>
            A spec registry points at these images, but nothing has downloaded them —
            which is the failure this page exists to make visible. Run{' '}
            <code>specs generate --get-images</code> for images found on components, or add{' '}
            <code>images</code> to the source&apos;s <code>fetch</code> list for the ones
            carried by fill styles.
          </p>
          <ul style={{ marginBottom: 0 }}>
            {images.missing.map((m) => (
              <li key={m.hash}>
                <code>{m.hash}</code> — referenced by {m.referencedBy.join(', ')}
              </li>
            ))}
          </ul>
        </div>
      )}

      <p>
        Every image in the workspace, whichever way it arrived
        ({images.present.length} total, {fromStyles} carried by a fill style
        {unaccounted > 0 ? `, ${unaccounted} unaccounted for` : ''}). Reference one
        from a spec by its file path under <code>assets/images/</code>.
      </p>

      {unaccounted > 0 && (
        <p style={{ opacity: 0.75 }}>
          An image is unaccounted for when a file is present but neither{' '}
          <code>specs fetch</code> nor <code>specs generate --get-images</code> has
          recorded finding it — usually a file downloaded before either kept a record.
          Re-run both to account for it.
        </p>
      )}

      <div
        style={{
          display: 'grid',
          gridTemplateColumns: 'repeat(auto-fill, minmax(180px, 1fr))',
          gap: 20,
          marginTop: 24,
        }}
      >
        {images.present.map((image) => (
          <figure key={image.file} style={{ margin: 0, minWidth: 0 }}>
            <img
              src={`/assets/images/${image.file}`}
              alt=""
              loading="lazy"
              style={{
                width: '100%',
                aspectRatio: '4 / 3',
                objectFit: 'cover',
                borderRadius: 4,
                background: 'rgba(0,0,0,0.04)',
                display: 'block',
              }}
            />
            <figcaption style={{ fontSize: 12, lineHeight: 1.5, marginTop: 8 }}>
              <div style={{ fontWeight: 600, wordBreak: 'break-word' }}>
                {image.name ?? <span style={{ opacity: 0.6 }}>Unnamed</span>}
              </div>
              <div style={{ opacity: 0.7 }}>
                {originText(image.origin)} · {kb(image.bytes)}
              </div>
              <code
                style={{ fontSize: 11, opacity: 0.6, wordBreak: 'break-all', display: 'block' }}
                title={image.file}
              >
                {image.file}
              </code>
              {image.referencedBy.length > 0 && (
                <div style={{ opacity: 0.7, marginTop: 4 }}>
                  Used by {image.referencedBy.join(', ')}
                </div>
              )}
            </figcaption>
          </figure>
        ))}
      </div>
    </>
  );
}

const meta = {
  title: 'Foundations/Images',
  parameters: { docs: { page: ImagesPage } },
} satisfies Meta;

export default meta;
export const Page: StoryObj = { render: () => <ImagesPage /> };
