// Generated by `specs storybook` (components concern). Do not edit —
// regenerate with `specs storybook publish components`.
//
// One component's visual diffs for one platform against one baseline, as a
// sidebar leaf under that component. The Testing section's own pages rank every
// component against each other; this shows one component's variants in full.
// The report JSON is served live at /baselines, so a re-diff updates this page
// on reload.
import * as React from 'react';
import type { Meta, StoryObj } from '@storybook/react';

/** One manifest variant's result — the subset of the report's pair shape this page shows. */
type Pair = {
  nodeId: string;
  config: Record<string, string>;
  status: string;
  pass: boolean | null;
  dims?: { dw: number; dh: number };
  diffPct?: number;
  triptychPng?: string;
  note?: string;
  error?: string;
};

type Entry = {
  summary: {
    passPct: number;
    variants: number;
    pass: number;
    fail: number;
    deferred: number;
    ignored?: number;
  };
  pairs: Pair[];
};

type Report = {
  generatedAt: string;
  settings: { passPct: number; scale: number };
  components: Record<string, Entry>;
  compositions?: Record<string, Entry>;
};

/**
 * Reports written before the platform split carry no target and held React
 * results, so React falls back to the untargeted name. Web Components never had
 * an untargeted report and must not read React's.
 */
const REPORT_CANDIDATES: string[] = {{REPORT_CANDIDATES}};

const PASS_COLOR = '#2e9960';
const FAIL_COLOR = '#d64545';
const MUTED = '#666';

/** The variant's identity: its props, or `default` when it has none. */
function configLabel(config: Record<string, string>): string {
  return Object.entries(config).map(([k, v]) => `${k}=${v}`).join(', ') || 'default';
}

function PairRow({ pair }: { pair: Pair }) {
  const parts: string[] = [configLabel(pair.config)];
  if (pair.status === 'diffed') {
    parts.unshift(`${pair.diffPct}%`);
    if (pair.dims && (pair.dims.dw !== 0 || pair.dims.dh !== 0)) {
      parts.splice(1, 0, `dw ${pair.dims.dw} dh ${pair.dims.dh}`);
    }
  } else {
    parts.push(pair.status);
  }
  const aside = pair.note ?? pair.error;
  const color = pair.pass === true ? PASS_COLOR : pair.pass === false ? FAIL_COLOR : MUTED;
  const glyph = pair.pass === true ? '✓' : pair.pass === false ? '✗' : '–';
  return (
    <div style={{ marginBottom: 16 }}>
      <div style={{ color, fontVariantNumeric: 'tabular-nums' }}>
        <span style={{ marginRight: 6 }}>{glyph}</span>
        {parts.join(' · ')}
      </div>
      {aside ? <div style={{ color: MUTED, marginTop: 2 }}>{aside}</div> : null}
      {pair.triptychPng ? (
        <img
          src={`/baselines/${pair.triptychPng}`}
          alt={`${configLabel(pair.config)} — baseline, render, diff`}
          style={{ maxWidth: '100%', marginTop: 6, border: '1px solid #ddd', borderRadius: 4 }}
        />
      ) : null}
    </div>
  );
}

function ComponentTestingPage() {
  const [report, setReport] = React.useState<Report | null>(null);
  const [missing, setMissing] = React.useState(false);

  React.useEffect(() => {
    let live = true;
    (async () => {
      for (const name of REPORT_CANDIDATES) {
        const res = await fetch(`/baselines/report/${name}.json`).catch(() => null);
        if (!live) return;
        if (res?.ok) return setReport(await res.json());
      }
      if (live) setMissing(true);
    })();
    return () => {
      live = false;
    };
  }, []);

  const note: React.CSSProperties = { color: MUTED, font: '13px system-ui' };
  // The sidebar shows the view name alone, so the heading is the only place the
  // page says which component it belongs to.
  const heading = <h1>{ {{PAGE_HEADING}} }</h1>;
  if (missing) {
    return (
      <>
        {heading}
        <p style={note}>
          No results yet — run <code>specs testing visual diff{{DIFF_FLAG}}</code>, then reload.
        </p>
      </>
    );
  }
  if (!report) return <>{heading}<p style={note}>Loading results…</p></>;

  // Reports are keyed by spec folder key, which is the key this page was named
  // after — so this is a lookup, not a match. Publish only writes this page when
  // the key is present, so an absent entry means the report moved underneath it.
  const entries = '{{KIND}}' === 'compositions' ? report.compositions : report.components;
  const entry = entries?.['{{SLUG}}'];
  if (!entry) {
    return (
      <>
        {heading}
        <p style={note}>
          This spec is no longer in the report — re-run <code>specs storybook</code> to catch the page up.
        </p>
      </>
    );
  }

  const s = entry.summary;
  return (
    <div style={{ font: '13px system-ui' }}>
      {heading}
      <p style={{ color: MUTED, margin: '0 0 16px' }}>
        {new Date(report.generatedAt).toLocaleString()} · baseline: {{BASELINE_LABEL}} · scale{' '}
        {report.settings.scale} · <b style={{ color: PASS_COLOR }}>{s.pass} pass</b> ·{' '}
        <b style={{ color: s.fail ? FAIL_COLOR : undefined }}>{s.fail} fail</b> of {s.variants} variants
        {s.deferred ? ` · ${s.deferred} deferred` : ''}
        {s.ignored ? ` · ${s.ignored} ignored` : ''} · pass at {s.passPct}%
      </p>
      {entry.pairs.map((p) => (
        <PairRow key={p.nodeId} pair={p} />
      ))}
      <p style={{ color: '#999', margin: '8px 0 24px' }}>
        Every variant the manifest lists, in its order. Each image is baseline, render, diff.
      </p>
    </div>
  );
}

const meta = {
  title: '{{NAV_TITLE}}',
  parameters: { docs: { page: ComponentTestingPage }, layout: 'padded' },
} satisfies Meta;

export default meta;
export const Page: StoryObj = { render: () => <ComponentTestingPage /> };
